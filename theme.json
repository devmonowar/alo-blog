{
	"$schema": "https://schemas.wp.org/wp/6.4/theme.json",
	"version": 2,
	"settings": {
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{
					"slug": "background",
					"name": "Background",
					"color": "#FFFFFF"
				},
				{
					"slug": "foreground",
					"name": "Foreground",
					"color": "#1A1A1A"
				},
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#1D4ED8"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#5F6368"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#EEF2FF"
				},
				{
					"slug": "footer-background",
					"name": "Footer Background",
					"color": "#111827"
				}
			]
		},
		"typography": {
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "14px"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "17px"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "26px"
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "32px"
				},
				{
					"slug": "xx-large",
					"name": "Extra Extra Large",
					"size": "clamp(2.25rem, 5vw, 3rem)"
				}
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%" ],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "2X-Small",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "X-Small",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "Small",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "Medium",
					"size": "2rem"
				},
				{
					"slug": "60",
					"name": "Large",
					"size": "3rem"
				},
				{
					"slug": "70",
					"name": "X-Large",
					"size": "4.5rem"
				},
				{
					"slug": "80",
					"name": "2X-Large",
					"size": "6rem"
				}
			]
		}
	},
	"styles": {
 "color": {
  "background": "var:preset|color|background",
  "text": "var:preset|color|foreground"
 },
		"typography": {
			"fontSize": "17px",
			"lineHeight": "1.7"
		},
		"elements": {
  "link": {
   "color": {
    "text": "var:preset|color|primary"
   }
  },
			"heading": {
				"typography": {
					"lineHeight": "1.25"
				}
			}
		}
	}
}
